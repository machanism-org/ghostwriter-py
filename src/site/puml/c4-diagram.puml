' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `src/main/python` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.

@startuml c4-ghostwriter-python
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
title Ghostwriter Python Wrapper - Component Diagram

Person(cliUser, "CLI or Python user", "Invokes Ghostwriter through the mgw command, python -m mgw, or the Python API")
System_Ext(pythonRuntime, "Python runtime", "Executes the installed mgw package")
System_Ext(jpype, "JPype", "Bridges Python calls to the Java Virtual Machine")
System_Ext(javaRuntime, "Java Virtual Machine", "Runs the bundled Ghostwriter Java implementation")
System_Ext(mavenResolver, "Maven resolver", "Resolves optional library coordinates through jgo")
System_Ext(mavenRepository, "Maven repository", "Hosts optional Java libraries")

Container_Boundary(mgwPackage, "mgw Python package") {
    Component(publicApi, "Public API", "mgw/__init__.py", "Lazily exposes gw, gdp, and adw without eagerly importing the implementation")
    Component(entryPoint, "Console/module entry point", "mgw/__main__.py", "Routes mgw and python -m mgw invocations to the Ghostwriter wrapper")
    Component(wrapper, "Ghostwriter wrapper", "mgw/_ghostwriter.py", "Validates settings, resolves libraries, starts the JVM, and invokes Ghostwriter, GuidanceProcessor, or ActProcessor")
    Component(runtimeJar, "Bundled Ghostwriter runtime", "mgw/jars/ghostwriter.jar", "Packaged Java implementation used as the default JVM class path")
}

Rel(cliUser, entryPoint, "Runs")
Rel(cliUser, publicApi, "Calls")
Rel(pythonRuntime, publicApi, "Loads")
Rel(pythonRuntime, entryPoint, "Executes")
Rel(entryPoint, wrapper, "Calls gw(args)")
Rel(publicApi, wrapper, "Lazily delegates gw, gdp, or adw")
Rel(wrapper, jpype, "Uses")
Rel(jpype, javaRuntime, "Starts and accesses")
Rel(wrapper, runtimeJar, "Places on class path")
Rel(wrapper, mavenResolver, "Resolves optional libs")
Rel(mavenResolver, mavenRepository, "Downloads artifacts")
Rel(javaRuntime, runtimeJar, "Loads")
Rel(wrapper, javaRuntime, "Invokes Java processors and returns results")

SHOW_LEGEND()
@enduml
